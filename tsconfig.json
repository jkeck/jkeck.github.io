{
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "assets/js/comments/**/*.js",
    "test/unit/**/*.js",
    "test/fakes/**/*.js"
  ],
  "exclude": [
    "test/integration/**/*.js"
  ]
}
